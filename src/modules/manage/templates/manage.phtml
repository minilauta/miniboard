<!DOCTYPE html>
<html>
  <head>
    <?=$this->render(__ROOT__ . '/common/templates/meta.phtml')?>
    <?=$this->render(__ROOT__ . '/common/templates/styles.phtml')?>
    <?=$this->render(__ROOT__ . '/common/templates/scripts.phtml')?>
    <title><?=__('manage.title')?></title>
  </head>
  <body>
    <?=$this->render(__DIR__ . '/components/menubar.phtml')?>
    <?=$this->render(__ROOT__ . '/common/templates/header.phtml', ['h_title' => __('manage.title'), 'h_subtitle' => __('manage.management_iface') . " :: <b>$route</b>"])?>
    <hr>
    <?php
      switch ($route) {
        case 'import':
          if (funcs_common_get_role() !== MB_ROLE_SUPERADMIN) {
            throw new \AppException('manage.phtml', 'inline', 'insufficient permissions', SC_FORBIDDEN);
          }

          echo $this->render(__DIR__ . '/components/importform.phtml', ['status' => $status]);
          break;
        case 'rebuild':
          if (funcs_common_get_role() !== MB_ROLE_SUPERADMIN) {
            throw new \AppException('manage.phtml', 'inline', 'insufficient permissions', SC_FORBIDDEN);
          }

          echo $this->render(__DIR__ . '/components/rebuildform.phtml', ['status' => $status]);
          break;
        case 'config':
          // the site-wide config, the keys the role can access
          $config_access = funcs_manage_config_access();
          if (!$config_access->has_any(funcs_common_get_role(), minichan\core\ConfigScope::Global, minichan\core\ConfigScope::Inheritable)) {
            throw new \AppException('manage.phtml', 'inline', 'insufficient permissions', SC_FORBIDDEN);
          }

          echo $this->render(__DIR__ . '/components/configform.phtml', [
            'store' => minichan\core\ConfigStore::instance(),
            'access' => $config_access,
            'status' => $status,
          ]);
          break;
        case 'boards':
          // the boards the role can access, if it can access a board or inheritable key
          $config_access = funcs_manage_config_access();
          if (!$config_access->has_any(funcs_common_get_role(), minichan\core\ConfigScope::Board, minichan\core\ConfigScope::Inheritable)) {
            throw new \AppException('manage.phtml', 'inline', 'insufficient permissions', SC_FORBIDDEN);
          }

          $config_store = minichan\core\ConfigStore::instance();
          $values = $config_store->values();
          $board_keys = minichan\core\ConfigSchema::keys_of(minichan\core\ConfigScope::Board);
          $inheritable_keys = minichan\core\ConfigSchema::keys_of(minichan\core\ConfigScope::Inheritable);

          $board_ids = array_map('strval', array_keys($config_store->boards()));
          $board_ids = array_merge($board_ids, array_values(array_diff($config_store->board_ids(), $board_ids)));
          $board_ids = array_filter($board_ids, fn(string $board_id) => minichan\core\ConfigAccess::can_access_board(funcs_common_get_role(), $board_id, $config_store));

          // get boards
          $boards = [];
          foreach ($board_ids as $board_id) {
            $boards[] = [
              'id' => $board_id,
              'name' => $values[$board_id]['name'] ?? null,
              'desc' => $values[$board_id]['desc'] ?? null,
              'type' => $values[$board_id]['type'] ?? null,
              'position' => $values[$board_id]['position'] ?? null,
              'missing' => array_keys(array_diff_key($board_keys, $values[$board_id])),
              'posts_n' => count_board_posts($board_id),
              'overrides_n' => count(array_intersect_key($values[$board_id], $inheritable_keys)),
            ];
          }

          echo $this->render(__DIR__ . '/components/boardform.phtml', [
            'store' => $config_store,
            'boards' => $boards,
            'status' => $status,
          ]);
          break;
        case 'edit_board':
          $config_access = funcs_manage_config_access();
          if (!$config_access->has_any(funcs_common_get_role(), minichan\core\ConfigScope::Board, minichan\core\ConfigScope::Inheritable)) {
            throw new \AppException('manage.phtml', 'inline', 'insufficient permissions', SC_FORBIDDEN);
          }

          // get query params
          $query_board_id = funcs_common_parse_input_str($query_params, 'board_id', null);

          // get board, including a board ignored for missing board keys so it can be fixed or deleted
          $config_store = minichan\core\ConfigStore::instance();
          if (!in_array($query_board_id, $config_store->board_ids(), true)) {
            $query_board_id = htmlspecialchars($query_board_id, ENT_QUOTES, 'UTF-8');
            throw new \AppException('manage.phtml', 'inline', "board /{$query_board_id}/ not found", SC_NOT_FOUND);
          }

          if (!minichan\core\ConfigAccess::can_access_board(funcs_common_get_role(), $query_board_id, $config_store)) {
            throw new \AppException('manage.phtml', 'inline', 'insufficient permissions', SC_FORBIDDEN);
          }

          $board_keys = minichan\core\ConfigSchema::keys_of(minichan\core\ConfigScope::Board);

          echo $this->render(__DIR__ . '/components/editboardform.phtml', [
            'store' => $config_store,
            'access' => $config_access,
            'board_id' => $query_board_id,
            'missing' => array_keys(array_diff_key($board_keys, $config_store->values()[$query_board_id])),
            'posts_n' => count_board_posts($query_board_id),
            'status' => $status,
          ]);
          break;
        case 'accounts':
          if (funcs_common_get_role() !== MB_ROLE_SUPERADMIN) {
            throw new \AppException('manage.phtml', 'inline', 'insufficient permissions', SC_FORBIDDEN);
          }

          // set constants
          $accounts_per_page = 10;

          // get accounts
          $accounts = select_all_accounts(false, $accounts_per_page * $page, $accounts_per_page);

          // get account count
          $accounts_n = count_all_accounts();

          // calculate page count
          $page_n = ceil($accounts_n / $accounts_per_page);

          echo $this->render(__DIR__ . '/components/accountform.phtml', [
            'accounts' => $accounts,
            'page' => $page,
            'page_n' => $page_n,
            'status' => $status,
          ]);
          echo $this->render(__ROOT__ . '/common/templates/pagetable.phtml', ['page' => $page, 'page_n' => $page_n]);
          break;
        case 'logs':
          // set constants
          $logs_per_page = 100;

          // get logs
          $logs = select_all_logs(true, $logs_per_page * $page, $logs_per_page);

          // process logs
          foreach ($logs as $key => &$log) {
            $log['username_rendered'] = funcs_common_get_role() === MB_ROLE_SUPERADMIN ? $log['username'] : '<s>REDACTED</s>';
          }

          // get log count
          $logs_n = count_all_logs();

          // calculate page count
          $page_n = ceil($logs_n / $logs_per_page);

          echo $this->render(__DIR__ . '/components/logform.phtml', [
            'logs' => $logs,
            'page' => $page,
            'page_n' => $page_n,
            'status' => $status,
          ]);
          echo $this->render(__ROOT__ . '/common/templates/pagetable.phtml', ['page' => $page, 'page_n' => $page_n]);
          break;
        case 'bans':
          // set constants
          $bans_per_page = 50;

          // get bans
          $bans = select_all_bans(true, $bans_per_page * $page, $bans_per_page);

          // process bans
          foreach ($bans as $key => &$ban) {
            $is_superadmin = funcs_common_get_role() === MB_ROLE_SUPERADMIN;
            $ban['ip_rendered'] = $is_superadmin ? $ban['ip_str'] : '<s>REDACTED</s>';

            // render the range end only for actual range bans (ip_end not null)
            if ($ban['ip_end_str'] !== null && $ban['ip_end_str'] !== $ban['ip_str']) {
              $ban['ip_rendered'] .= $is_superadmin ? ' - ' . $ban['ip_end_str'] : ' <s>(range)</s>';
            }
          }

          // get ban count
          $bans_n = count_all_bans();

          // calculate page count
          $page_n = ceil($bans_n / $bans_per_page);

          echo $this->render(__DIR__ . '/components/banform.phtml', [
            'bans' => $bans,
            'page' => $page,
            'page_n' => $page_n,
            'status' => $status,
          ]);
          echo $this->render(__ROOT__ . '/common/templates/pagetable.phtml', ['page' => $page, 'page_n' => $page_n]);
          break;
        case 'file_scanner_hashes':
          // set constants
          $rows_per_page = 50;

          // get rows
          $rows = select_all_file_scanner_hashes(true, $rows_per_page * $page, $rows_per_page);

          // process rows
          foreach ($rows as $key => &$row) {
            $row['sha256'] = bin2hex($row['sha256']);
            $row['hash'] = bin2hex($row['hash']);
          }

          // get row count
          $rows_n = count_all_file_scanner_hashes();

          // calculate page count
          $page_n = ceil($rows_n / $rows_per_page);

          echo $this->render(__DIR__ . '/components/filescannerhashform.phtml', [
            'rows' => $rows,
            'page' => $page,
            'page_n' => $page_n,
            'status' => $status,
          ]);
          echo $this->render(__ROOT__ . '/common/templates/pagetable.phtml', ['page' => $page, 'page_n' => $page_n]);
          break;
        case 'filters':
          if (funcs_common_get_role() > MB_ROLE_ADMIN) {
            throw new \AppException('manage.phtml', 'inline', 'insufficient permissions', SC_FORBIDDEN);
          }

          // set constants
          $filters_per_page = 50;

          // get filters
          $filters = select_all_post_filters(true, $filters_per_page * $page, $filters_per_page);

          // get filter count
          $filters_n = count_all_post_filters();

          // calculate page count
          $page_n = ceil($filters_n / $filters_per_page);

          echo $this->render(__DIR__ . '/components/filterform.phtml', [
            'filters' => $filters,
            'page' => $page,
            'page_n' => $page_n,
            'status' => $status,
          ]);
          echo $this->render(__ROOT__ . '/common/templates/pagetable.phtml', ['page' => $page, 'page_n' => $page_n]);
          break;
        case 'posts':
          // set constants
          $posts_per_page = 50;

          // get posts
          $posts = select_all_posts(true, $posts_per_page * $page, $posts_per_page);

          // process posts (if thread returned, set thread related values)
          foreach ($posts as $key => &$post) {
            $post['ip_rendered'] = funcs_common_get_role() === MB_ROLE_SUPERADMIN ? $post['ip_str'] : '<s>REDACTED</s>';

            if ($post['parent_id'] != 0) {
              continue;
            }

            $post['replies'] = [];
            $post['replies_n'] = count_posts('NULL', $post['board_id'], $post['post_id'], false, false);
          }

          // get post count
          $posts_n = count_all_posts();

          // calculate page count
          $page_n = ceil($posts_n / $posts_per_page);

          echo $this->render(__DIR__ . '/components/modform.phtml', [
            'posts' => $posts,
            'page' => $page,
            'page_n' => $page_n,
            'status' => $status,
          ]);
          echo $this->render(__ROOT__ . '/common/templates/pagetable.phtml', ['page' => $page, 'page_n' => $page_n]);
          break;
        case 'threads':
          // set constants
          $posts_per_page = 50;

          // get posts
          $posts = select_all_threads(true, $posts_per_page * $page, $posts_per_page);

          // process posts
          foreach ($posts as $key => &$post) {
            $post['ip_rendered'] = funcs_common_get_role() === MB_ROLE_SUPERADMIN ? $post['ip_str'] : '<s>REDACTED</s>';
            $post['replies'] = [];
            $post['replies_n'] = count_posts('NULL', $post['board_id'], $post['post_id'], false, false);
          }

          // get post count
          $posts_n = count_all_threads();

          // calculate page count
          $page_n = ceil($posts_n / $posts_per_page);

          echo $this->render(__DIR__ . '/components/modform.phtml', [
            'posts' => $posts,
            'page' => $page,
            'page_n' => $page_n,
            'status' => $status,
          ]);
          echo $this->render(__ROOT__ . '/common/templates/pagetable.phtml', ['page' => $page, 'page_n' => $page_n]);
          break;
        case 'edit_post':
          // get query params
          $query_board_id = htmlspecialchars(funcs_common_parse_input_str($query_params, 'board_id', null), ENT_QUOTES, 'UTF-8');
          $query_post_id = funcs_common_parse_input_int($query_params, 'post_id', null, 0);

          // get post
          $post = select_post($query_board_id, $query_post_id);
          if (!$post) {
            throw new \AppException('manage.phtml', 'inline', "post /{$query_board_id}/{$query_post_id}/ not found", SC_NOT_FOUND);
          }

          echo $this->render(__DIR__ .'/components/editform.phtml', [
            'post' => $post,
          ]);
          break;
        case 'edit_ban':
          // get query params
          $query_id = funcs_common_parse_input_int($query_params, 'id', null, 0);

          // get ban
          $ban = select_ban_by_id($query_id);
          if (!$ban) {
            throw new \AppException('manage.phtml', 'inline', "ban #{$query_id} not found", SC_NOT_FOUND);
          }

          // render ip (redacted for non-superadmins, same as the bans list)
          $is_superadmin = funcs_common_get_role() === MB_ROLE_SUPERADMIN;
          $ban['ip_rendered'] = $is_superadmin ? $ban['ip_str'] : '<s>REDACTED</s>';
          if ($ban['ip_end_str'] !== null && $ban['ip_end_str'] !== $ban['ip_str']) {
            $ban['ip_rendered'] .= $is_superadmin ? ' - ' . $ban['ip_end_str'] : ' <s>(range)</s>';
          }

          echo $this->render(__DIR__ .'/components/editbanform.phtml', [
            'ban' => $ban,
          ]);
          break;
        case 'edit_file_scanner_hash':
          // get query params
          $query_id = funcs_common_parse_input_int($query_params, 'id', null, 0);

          // get file scanner hash
          $row = select_file_scanner_hash_by_id($query_id);
          if (!$row) {
            throw new \AppException('manage.phtml', 'inline', "file hash #{$query_id} not found", SC_NOT_FOUND);
          }

          // get every hash of the same file (including this one)
          $row['sha256'] = bin2hex($row['sha256']);
          $row['hash'] = bin2hex($row['hash']);
          $related = select_file_scanner_hashes_by_sha256($row['sha256']);

          echo $this->render(__DIR__ .'/components/editfilescannerhashform.phtml', [
            'row' => $row,
            'related' => $related,
          ]);
          break;
        case 'edit_filter':
          if (funcs_common_get_role() > MB_ROLE_ADMIN) {
            throw new \AppException('manage.phtml', 'inline', 'insufficient permissions', SC_FORBIDDEN);
          }

          // get query params
          $query_id = funcs_common_parse_input_int($query_params, 'id', null, 0);

          // get filter
          $filter = select_post_filter_by_id($query_id);
          if (!$filter) {
            throw new \AppException('manage.phtml', 'inline', "filter #{$query_id} not found", SC_NOT_FOUND);
          }

          echo $this->render(__DIR__ .'/components/editfilterform.phtml', [
            'filter' => $filter,
          ]);
          break;
        case 'edit_account':
          if (funcs_common_get_role() !== MB_ROLE_SUPERADMIN) {
            throw new \AppException('manage.phtml', 'inline', 'insufficient permissions', SC_FORBIDDEN);
          }

          // get query params
          $query_id = funcs_common_parse_input_int($query_params, 'id', null, 0);

          // get account
          $account = select_account_by_id($query_id);
          if (!$account) {
            throw new \AppException('manage.phtml', 'inline', "account #{$query_id} not found", SC_NOT_FOUND);
          }

          echo $this->render(__DIR__ .'/components/editaccountform.phtml', [
            'account' => $account,
            'is_self' => $account['username'] === ($_SESSION['mb_username'] ?? null),
          ]);
          break;
        case 'reports':
        default:
          // set constants
          $reports_per_page = 50;

          // get reports
          $reports = select_all_reports(true, $reports_per_page * $page, $reports_per_page);

          // process reports (if thread returned, set thread related values)
          foreach ($reports as $key => &$report) {
            $report['r_ip_rendered'] = funcs_common_get_role() === MB_ROLE_SUPERADMIN ? $report['r_ip_str'] : '<s>REDACTED</s>';
            $report['ip_rendered'] = funcs_common_get_role() === MB_ROLE_SUPERADMIN ? $report['ip_str'] : '<s>REDACTED</s>';

            if ($report['parent_id'] != 0) {
              continue;
            }

            $report['replies'] = [];
            $report['replies_n'] = count_posts('NULL', $report['board_id'], $report['post_id'], false, false);
          }

          // get report count
          $reports_n = count_all_reports();

          // calculate page count
          $page_n = ceil($reports_n / $reports_per_page);

          echo $this->render(__DIR__ . '/components/reportform.phtml', [
            'reports' => $reports,
            'page' => $page,
            'page_n' => $page_n,
            'status' => $status,
          ]);
          echo $this->render(__ROOT__ . '/common/templates/pagetable.phtml', ['page' => $page, 'page_n' => $page_n]);
          break;
      }
    ?>
    <hr>
    <div class="container-centered">
      <?=$this->render(__ROOT__ . '/common/templates/footer.phtml')?>
    </div>
  </body>
</html>
