          if (count($bans) === 0) {
            echo "<tr><td class='cell-empty' colspan='8'>" . __('manage.no_entries') . "</td></tr>";
          }

          $editLabel = __('manage.edit_ban');
          foreach ($bans as $ban) {
            $timestamp = date(MB_DATEFORMAT, $ban['timestamp']);
            $expire = date(MB_DATEFORMAT, $ban['expire']);
            $imported = $ban['imported'] === 1 ? '<b>TRUE</b>' : 'FALSE';

            echo "
              <tr>
                <td>{$ban['id']}</td>
                <td>{$ban['ip_rendered']}</td>
                <td>{$timestamp}</td>
                <td>{$expire}</td>
                <td class=\"cell-wrap\">{$ban['reason']}</td>
                <td class=\"cell-wrap\">{$ban['comment']}</td>
                <td>{$imported}</td>
                <td class=\"cell-center\"><a href='?route=edit_ban&id={$ban['id']}'>{$editLabel}</a></td>
              </tr>
            ";
          }
        ?>
