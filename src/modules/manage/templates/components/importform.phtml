<form id="form-import" class="form-import form-manage form" method="post" action="import">
  <?=funcs_common_csrf_field()?>
  <table>
    <tbody>
      <tr>
        <td class="form-label">
          <label><?=__('manage.status')?></label>
        </td>
        <td>
          <b><?=$status?></b>
        </td>
      </tr>
      <tr>
        <td class="form-label">
          <label><?=__('manage.source_db')?></label>
        </td>
        <td class="form-fields">
          <div>
            <input type="text" name="db_name" placeholder="<?=__('manage.db_name')?>">
          </div>
          <div>
            <input type="text" name="db_user" placeholder="<?=__('manage.db_user')?>">
          </div>
          <div>
            <input type="password" name="db_pass" placeholder="<?=__('manage.db_pass')?>">
          </div>
        </td>
      </tr>
      <tr>
        <td class="form-label">
          <label><?=__('manage.source_table')?></label>
        </td>
        <td class="form-fields">
          <div>
            <input type="text" name="table_name" placeholder="<?=__('manage.table_name')?>">
          </div>
          <div>
            <label>
              <?=__('manage.table_type')?>
              <?php
                $options = '<option value=""></option>';
                foreach (MB_IMPORT_TABLE_TYPES as $key => $val) {
                  $options .= "<option value='{$key}'>{$val}</option>";
                }

                echo "<select id='table_type' name='table_type'>{$options}</select>";
              ?>
            </label>
          </div>
        </td>
      </tr>
      <tr>
        <td class="form-label">
          <label for="board_id"><?=__('manage.target_board')?></label>
        </td>
        <td class="form-fields">
          <div>
            <?php
              $options = '<option value=""></option>';
              foreach (MB_BOARDS as $key => $val) {
                if ($val['type'] === 'main') {
                  continue;
                }

                $options .= "<option value='{$key}'>/{$key}/ - {$val['name']}</option>";
              }

              echo "<select id='board_id' name='board_id'>{$options}</select>";
            ?>
          </div>
        </td>
      </tr>
      <tr>
        <td class="form-label">
          <label><?=__('form.submit')?></label>
        </td>
        <td>
          <input type="submit" value="<?=__('manage.import')?>">
        </td>
      </tr>
    </tbody>
  </table>
</form>
