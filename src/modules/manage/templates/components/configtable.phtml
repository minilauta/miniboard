<?php
  use minichan\core\ConfigAccess;
  use minichan\core\ConfigSchema;
  use minichan\core\ConfigScope;
  use minichan\core\ConfigType;

  /** @var minichan\core\ConfigStore $store */
  /** @var minichan\core\ConfigAccess $access */
  /** @var string $board_id 'global' or a board ID */

  $e = fn(mixed $value): string => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
  $is_global = $board_id === ConfigSchema::GLOBAL;
  $query = $e(http_build_query($is_global ? ['route' => 'config'] : ['route' => 'edit_board', 'board_id' => $board_id]));
  $values = $store->values();

  // site-wide: global and inheritable keys, board: board and inheritable keys, the keys the role can access
  $role = funcs_common_get_role();
  $is_superadmin = $role === MB_ROLE_SUPERADMIN;
  $keys = $access->keys_for($role, $board_id, $store);

  // only a superadmin sets the role required to access a key
  $role_names = [
    MB_ROLE_SUPERADMIN => __('manage.editaccountform.role_superadmin'),
    MB_ROLE_ADMIN      => __('manage.editaccountform.role_admin'),
    MB_ROLE_MODERATOR  => __('manage.editaccountform.role_moderator'),
  ];

  // the value a key has on this page, by the lookup order: the row of the board, the 'global' row, the default
  $value_of = function (string $key) use ($store, $values, $board_id) {
    if ($store->has($board_id, $key)) {
      return $values[$board_id][$key];
    }

    $definition = ConfigSchema::get($key);
    return $definition->scope === ConfigScope::Board ? $definition->default : $store->get($key);
  };
?>
<?php foreach ($keys as $key => $definition): ?>
  <form id="config-set-<?=$key?>" method="post" action="/manage/config_set?<?=$query?>">
    <?=funcs_common_csrf_field()?>
    <input type="hidden" name="board_id" value="<?=$e($board_id)?>">
    <input type="hidden" name="key" value="<?=$key?>">
  </form>
  <?php if ($definition->scope !== ConfigScope::Board && $store->has($board_id, $key)): ?>
    <form id="config-reset-<?=$key?>" method="post" action="/manage/config_reset?<?=$query?>">
      <?=funcs_common_csrf_field()?>
      <input type="hidden" name="board_id" value="<?=$e($board_id)?>">
      <input type="hidden" name="key" value="<?=$key?>">
    </form>
  <?php endif; ?>
  <?php if ($is_superadmin): ?>
    <form id="config-access-<?=$key?>" method="post" action="/manage/config_access?<?=$query?>">
      <?=funcs_common_csrf_field()?>
      <input type="hidden" name="key" value="<?=$key?>">
    </form>
  <?php endif; ?>
<?php endforeach; ?>
<div class="form-manage">
  <div class="form-manage-table-wrapper">
    <table class="form-manage-table">
      <thead>
        <tr>
          <th><?=__('manage.config.key')?></th>
          <th><?=__('manage.config.value')?></th>
          <th><?=__('manage.config.source')?></th>
          <?php if ($is_superadmin): ?>
            <th><?=__('manage.config.access')?></th>
          <?php endif; ?>
          <th class="cell-center"><?=__('manage.th.actions')?></th>
        </tr>
      </thead>
      <tbody>
        <?php if (count($keys) === 0): ?>
          <tr><td class="cell-empty" colspan="<?=$is_superadmin ? 5 : 4?>"><?=__('manage.no_entries')?></td></tr>
        <?php endif; ?>
        <?php foreach ($keys as $key => $definition): ?>
          <?php
            $form = "config-set-{$key}";
            $value = $value_of($key);
          ?>
          <tr>
            <td class="cell-wrap">
              <b><?=$key?></b><br>
              <small><?=$e($definition->description)?></small>
            </td>
            <td class="cell-wrap">
              <?php if ($definition->secret): ?>
                <input type="password" name="value" form="<?=$form?>" autocomplete="new-password" size="40" placeholder="<?=$value !== null && $value !== '' ? __('manage.config.secret_set') : __('manage.config.secret_unset')?>">
              <?php elseif ($definition->type === ConfigType::Bool): ?>
                <select name="value" form="<?=$form?>">
                  <option value="1"<?=$value === true ? ' selected' : ''?>>true</option>
                  <option value="0"<?=$value === false ? ' selected' : ''?>>false</option>
                </select>
              <?php elseif ($definition->type === ConfigType::Int || $definition->type === ConfigType::Float): ?>
                <input type="number" name="value" form="<?=$form?>" step="<?=$definition->type === ConfigType::Int ? '1' : 'any'?>" value="<?=$e($value)?>">
              <?php elseif ($definition->type === ConfigType::Json): ?>
                <?php $json = $value === null ? '' : json_encode($value, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_PRESERVE_ZERO_FRACTION); ?>
                <textarea name="value" form="<?=$form?>" class="cell-mono" cols="60" rows="<?=min(12, substr_count($json, "\n") + 1)?>"><?=$e($json)?></textarea>
              <?php elseif (is_string($value) && (str_contains($value, "\n") || strlen($value) > 60)): ?>
                <textarea name="value" form="<?=$form?>" cols="60" rows="<?=min(12, substr_count($value, "\n") + 2)?>"><?=$e($value)?></textarea>
              <?php else: ?>
                <input type="text" name="value" form="<?=$form?>" size="40" value="<?=$e($value)?>">
              <?php endif; ?>
              <?php if ($definition->nullable): ?>
                <label><input type="checkbox" name="null" value="1" form="<?=$form?>"<?=$value === null ? ' checked' : ''?>> <?=__('manage.config.null')?></label>
              <?php endif; ?>
            </td>
            <td>
              <?php
                $source = $store->source($key, $board_id);
                if ($definition->scope === ConfigScope::Board && $source === 'default') {
                  echo '<b>' . __('manage.config.source.missing') . '</b>';
                } else {
                  echo $source === 'board' ? '<b>' . __('manage.config.source.board') . '</b>' : __('manage.config.source.' . $source);
                }

                if ($is_global && $definition->scope === ConfigScope::Inheritable) {
                  // only the boards the role can access are linked
                  $overrides = array_filter($store->overrides($key), fn(string $id) => ConfigAccess::can_access_board($role, $id, $store));
                  if (count($overrides) > 0) {
                    $overrides = implode(', ', array_map(fn(string $id) => "<a href='?route=edit_board&board_id={$e(urlencode($id))}'>/{$e($id)}/</a>", $overrides));
                    echo '<br><small class="cell-list">' . __('manage.config.overridden', ['boards' => $overrides]) . '</small>';
                  }
                }
              ?>
            </td>
            <?php if ($is_superadmin): ?>
              <td>
                <?php $req_role = $access->req_role($key); ?>
                <select name="req_role" form="config-access-<?=$key?>">
                  <?php foreach (ConfigAccess::ROLES as $option): ?>
                    <option value="<?=$option?>"<?=$option === $req_role ? ' selected' : ''?>><?=$role_names[$option]?></option>
                  <?php endforeach; ?>
                </select>
                <input type="submit" form="config-access-<?=$key?>" value="<?=__('manage.config.access_set')?>">
              </td>
            <?php endif; ?>
            <td class="cell-center">
              <input type="submit" form="<?=$form?>" value="<?=__('manage.config.save')?>" onclick="return confirm(<?=$e(json_encode(__('manage.config.save_confirm', ['key' => $key])))?>);">
              <?php if ($definition->scope !== ConfigScope::Board && $store->has($board_id, $key)): ?>
                <input type="submit" form="config-reset-<?=$key?>" value="<?=__('manage.config.reset')?>" onclick="return confirm(<?=$e(json_encode(__('manage.config.reset_confirm', ['key' => $key])))?>);">
              <?php endif; ?>
            </td>
          </tr>
        <?php endforeach; ?>
      </tbody>
    </table>
  </div>
</div>
