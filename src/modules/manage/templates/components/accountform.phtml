          echo "
            <tr>
              <td>{$account['id']}</td>
              <td>{$account['username']}</td>
              <td>{$account['role']}</td>
              <td>{$lastactive}</td>
              <td>{$imported}</td>
              <td><a href='?route=edit_account&id={$account['id']}'>{$editLabel}</a></td>
