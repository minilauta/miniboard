        <?php
          if (count($rows) === 0) {
            echo "<tr><td class='cell-empty' colspan='11'>" . __('manage.no_entries') . "</td></tr>";
          }

          $editLabel = __('manage.edit_file_scanner_hash');
          foreach ($rows as $row) {
            $timestamp = date(MB_DATEFORMAT, $row['timestamp']);
            $type = htmlspecialchars($row['type'], ENT_QUOTES, 'UTF-8');
            $comment = htmlspecialchars($row['comment'] ?? '', ENT_QUOTES, 'UTF-8');
            $algorithm = htmlspecialchars($row['algorithm'], ENT_QUOTES, 'UTF-8');
            $originator = htmlspecialchars($row['originator'], ENT_QUOTES, 'UTF-8');

            echo "
              <tr>
                <td>{$row['id']}</td>
                <td class=\"cell-wrap cell-mono\">{$row['sha256']}</td>
                <td>{$type}</td>
                <td>{$row['content_type']}</td>
                <td class=\"cell-wrap\">{$comment}</td>
                <td>{$algorithm}</td>
                <td class=\"cell-wrap cell-mono\">{$row['hash']}</td>
                <td>{$row['quality']}</td>
                <td class=\"cell-wrap\">{$originator}</td>
                <td>{$timestamp}</td>
                <td class=\"cell-center\"><a href='?route=edit_file_scanner_hash&id={$row['id']}'>{$editLabel}</a></td>
              </tr>
            ";
          }
        ?>
      </tbody>
    </table>
