<?php
  /** @var minichan\core\ConfigStore $store */
  /** @var array $boards rows of the boards table, see the 'boards' route of manage.phtml */

  $e = fn(mixed $value): string => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
  $query = $e(http_build_query(['route' => 'boards']));

  $next_position = 10;
  foreach ($store->boards() as $board) {
    $next_position = max($next_position, $board['position'] + 10);
  }

  // only a superadmin creates (and deletes) boards, the only actions that return here with a status
  $is_superadmin = funcs_common_get_role() === MB_ROLE_SUPERADMIN;
?>
<?php if ($is_superadmin): ?>
<form id="createboardform" class="form-manage form" method="post" action="/manage/config_create_board?<?=$query?>">
  <?=funcs_common_csrf_field()?>
  <table>
    <tbody>
      <tr>
        <td class="form-label">
          <label><?=__('manage.status')?></label>
        </td>
        <td>
          <b><?=$status?></b>
        </td>
      </tr>
      <tr>
        <td class="form-label">
          <label><?=__('manage.config.new_board')?></label>
        </td>
        <td class="form-fields">
          <div>
            <input type="text" name="board_id" placeholder="<?=__('manage.config.board_id')?>" maxlength="8" pattern="[a-z0-9]{1,8}" autocomplete="off" required>
          </div>
          <div>
            <input type="text" name="name" placeholder="<?=__('manage.config.name')?>" autocomplete="off" required>
          </div>
          <div>
            <input type="text" name="desc" placeholder="<?=__('manage.config.desc')?>" autocomplete="off">
          </div>
          <div>
            <label>
              <?=__('manage.config.type')?>
              <select name="type">
                <option value="normal" selected>normal</option>
                <option value="main">main</option>
              </select>
            </label>
          </div>
          <div>
            <label>
              <?=__('manage.config.position')?>
              <input type="number" name="position" step="1" value="<?=$next_position?>" required>
            </label>
          </div>
          <div>
            <label>
              <?=__('manage.config.copy_from')?>
              <select name="copy_from">
                <option value=""><?=__('manage.config.copy_none')?></option>
                <?php foreach ($store->boards() as $id => $board): ?>
                  <option value="<?=$e($id)?>">/<?=$e($id)?>/ - <?=$e($board['name'])?></option>
                <?php endforeach; ?>
              </select>
            </label>
          </div>
          <div>
            <input type="submit" value="<?=__('manage.config.create_board')?>">
          </div>
        </td>
      </tr>
    </tbody>
  </table>
</form>
<?php endif; ?>
<div class="form-manage">
  <div class="form-manage-table-wrapper">
    <table class="form-manage-table">
      <thead>
        <tr>
          <th><?=__('manage.th.board_id')?></th>
          <th><?=__('manage.th.name')?></th>
          <th><?=__('manage.th.desc')?></th>
          <th><?=__('manage.th.type')?></th>
          <th><?=__('manage.th.position')?></th>
          <th><?=__('manage.th.posts')?></th>
          <th><?=__('manage.th.overrides')?></th>
          <th class="cell-center"><?=__('manage.th.actions')?></th>
        </tr>
      </thead>
      <tbody>
        <?php
          if (count($boards) === 0) {
            echo "<tr><td class='cell-empty' colspan='8'>" . __('manage.no_entries') . "</td></tr>";
          }

          $editLabel = __('manage.edit_board');
          foreach ($boards as $board) {
            $id = $e($board['id']);
            $url_id = $e(urlencode($board['id']));

            // only a valid board can be opened, a board with missing board keys is ignored by the site
            if (count($board['missing']) === 0) {
              $id_cell = "<a href='/{$url_id}/'>/{$id}/</a>";
            } else {
              $invalid = __('manage.boardform.invalid', ['keys' => $e(implode(', ', $board['missing']))]);
              $id_cell = "/{$id}/<br><b>{$invalid}</b>";
            }

            $name = $e($board['name'] ?? '-');
            $desc = $e($board['desc'] ?? '-');
            $type = $e($board['type'] ?? '-');
            $position = $e($board['position'] ?? '-');

            echo "
              <tr>
                <td>{$id_cell}</td>
                <td class=\"cell-wrap\">{$name}</td>
                <td class=\"cell-wrap\">{$desc}</td>
                <td>{$type}</td>
                <td>{$position}</td>
                <td>{$board['posts_n']}</td>
                <td>{$board['overrides_n']}</td>
                <td class=\"cell-center\"><a href='?route=edit_board&board_id={$url_id}'>{$editLabel}</a></td>
              </tr>
            ";
          }
        ?>
      </tbody>
    </table>
  </div>
</div>
