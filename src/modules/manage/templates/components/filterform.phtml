<form id="filterform" class="form-manage" method="post">
  <div class="form-manage-table-wrapper">
    <table class="form-manage-table">
      <thead>
        <tr>
          <th><?=__('manage.th.id')?></th>
          <th><?=__('manage.th.board_id')?></th>
          <th><?=__('manage.th.match_type')?></th>
          <th><?=__('manage.th.pattern')?></th>
          <th><?=__('manage.th.action')?></th>
          <th><?=__('manage.th.replacement')?></th>
          <th><?=__('manage.th.duration')?></th>
          <th><?=__('manage.th.reason')?></th>
          <th><?=__('manage.th.comment')?></th>
          <th><?=__('manage.th.enabled')?></th>
          <th><?=__('manage.th.timestamp')?></th>
          <th class="cell-center"><?=__('manage.th.actions')?></th>
        </tr>
      </thead>
      <tbody>
        <?php
          if (count($filters) === 0) {
            echo "<tr><td class='cell-empty' colspan='12'>" . __('manage.no_entries') . "</td></tr>";
          }

          $editLabel = __('manage.edit_filter');
          $allBoardsLabel = __('manage.filter_board_all');
          foreach ($filters as $filter) {
            $id = (int) $filter['id'];
            $board = $filter['board_id'] !== null ? '/' . htmlspecialchars($filter['board_id'], ENT_QUOTES, 'UTF-8') . '/' : "<i>{$allBoardsLabel}</i>";
            $match_type = __('manage.filter_match_type.' . $filter['match_type']);
            $pattern = htmlspecialchars($filter['pattern'], ENT_QUOTES, 'UTF-8');
            $action = __('manage.filter_action.' . $filter['action']);
            $replacement = htmlspecialchars($filter['replacement'] ?? '', ENT_QUOTES, 'UTF-8');
            $duration = $filter['duration'] !== null ? intdiv((int) $filter['duration'], 60) : '';
            $reason = htmlspecialchars($filter['reason'] ?? '', ENT_QUOTES, 'UTF-8');
            $comment = htmlspecialchars($filter['comment'] ?? '', ENT_QUOTES, 'UTF-8');
            $enabled = $filter['enabled'] === 1 ? '<b>TRUE</b>' : 'FALSE';
            $timestamp = date(MB_DATEFORMAT, $filter['timestamp']);

            echo "
              <tr>
                <td>{$id}</td>
                <td>{$board}</td>
                <td>{$match_type}</td>
                <td class=\"cell-wrap cell-mono\">{$pattern}</td>
                <td>{$action}</td>
                <td class=\"cell-wrap cell-mono\">{$replacement}</td>
                <td>{$duration}</td>
                <td class=\"cell-wrap\">{$reason}</td>
                <td class=\"cell-wrap\">{$comment}</td>
                <td>{$enabled}</td>
                <td>{$timestamp}</td>
                <td class=\"cell-center\"><a href='?route=edit_filter&id={$id}'>{$editLabel}</a></td>
              </tr>
            ";
          }
        ?>
      </tbody>
    </table>
  </div>
</form>
