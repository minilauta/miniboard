          if (count($rows) === 0) {
            echo "<tr><td class='cell-empty' colspan='8'>" . __('manage.no_entries') . "</td></tr>";
          }

          foreach ($rows as $row) {
            $timestamp = date(MB_DATEFORMAT, $row['timestamp']);

            echo "
              <tr>
                <td>{$row['id']}</td>
                <td class=\"cell-wrap cell-mono\">{$row['sha256']}</td>
                <td>{$row['type']}</td>
                <td>{$row['algorithm']}</td>
                <td class=\"cell-wrap cell-mono\">{$row['hash']}</td>
                <td>{$row['quality']}</td>
                <td class=\"cell-wrap\">{$row['originator']}</td>
                <td>{$timestamp}</td>
              </tr>
            ";
          }
        ?>
      </tbody>
    </table>
